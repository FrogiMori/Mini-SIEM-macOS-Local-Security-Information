/* FrogiSIEM Terminal User Interface CSS
 * Palette:
 *   Background: near-black #07090e
 *   Surface: #0d1117 / #161b22
 *   Border: #1e293b / #334155
 *   Primary Accent: Neon Green #00ff66 / #10b981
 *   Critical Alert: #ef4444 (Vivid Red)
 *   High Alert: #f97316 (Orange)
 *   Medium Alert: #f59e0b (Amber/Yellow)
 *   Low Alert: #22c55e (Green)
 *   Muted Text: #64748b / #94a3b8
 *   Main Text: #e2e8f0 / #f8fafc
 */

Screen {
    background: #07090e;
    color: #e2e8f0;
}

/* ── Top FrogiSIEM Header ── */
#header-container {
    height: 3;
    dock: top;
    background: #0b0f19;
    border-bottom: heavy #00ff66;
    padding: 0 1;
}

.header-title {
    color: #00ff66;
    text-style: bold;
}

.header-meta {
    color: #94a3b8;
}

.header-status-online {
    color: #00ff66;
    text-style: bold;
}

.header-status-busy {
    color: #f59e0b;
    text-style: bold;
}

.header-status-error {
    color: #ef4444;
    text-style: bold;
}

/* ── Navigation Tabs Bar ── */
#nav-tabs-bar {
    height: 3;
    background: #0f172a;
    border-bottom: solid #1e293b;
    padding: 0 1;
    align-vertical: middle;
}

.nav-tab-btn {
    min-width: 14;
    height: 1;
    margin-right: 1;
    border: none;
    background: #1e293b;
    color: #94a3b8;
    text-style: bold;
}

.nav-tab-btn:hover {
    background: #334155;
    color: #00ff66;
}

.nav-tab-active {
    background: #00ff66;
    color: #07090e;
    text-style: bold;
}

/* ── Summary Metric Cards ── */
#metrics-row {
    height: 6;
    margin: 1 1 0 1;
    layout: grid;
    grid-size: 4 1;
    grid-gutter: 1;
}

.metric-card {
    height: 100%;
    background: #0d1117;
    border: round #334155;
    padding: 0 1;
    align-horizontal: center;
    align-vertical: middle;
}

.metric-card-crit {
    border: round #ef4444;
}

.metric-card-med {
    border: round #f59e0b;
}

.metric-card-sources {
    border: round #00ff66;
}

.metric-card-total {
    border: round #38bdf8;
}

.metric-number {
    text-style: bold;
    text-align: center;
}

.metric-label {
    color: #94a3b8;
    text-align: center;
    text-style: bold;
}

/* ── Content Containers ── */
.screen-container {
    height: 1fr;
    margin: 0 1;
}

.split-horizontal {
    layout: horizontal;
    height: 1fr;
}

.panel-box {
    background: #0d1117;
    border: round #1e293b;
    padding: 0 1;
    height: 100%;
}

.panel-title {
    color: #00ff66;
    text-style: bold;
    margin-bottom: 1;
}

/* ── DataTables ── */
DataTable {
    background: #07090e;
    border: none;
    color: #e2e8f0;
    scrollbar-color: #00ff66 #1e293b;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #0f172a;
    color: #00ff66;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1e293b;
    color: #00ff66;
    text-style: bold;
}

DataTable > .datatable--highlight {
    background: #1e293b;
}

/* ── Search & Filter Controls ── */
.filter-bar {
    height: 3;
    margin-bottom: 1;
    layout: horizontal;
    align-vertical: middle;
}

.search-input {
    width: 2fr;
    border: round #334155;
    background: #0d1117;
    color: #00ff66;
}

.search-input:focus {
    border: round #00ff66;
}

.filter-select {
    width: 1fr;
    margin-left: 1;
    border: round #334155;
    background: #0d1117;
}

/* ── Dossier & Detail Panel ── */
#dossier-panel {
    width: 45;
    background: #0b0f19;
    border-left: solid #334155;
    padding: 1;
}

.dossier-header {
    color: #ef4444;
    text-style: bold;
    border-bottom: solid #334155;
    padding-bottom: 1;
    margin-bottom: 1;
}

.dossier-label {
    color: #94a3b8;
    text-style: bold;
}

.dossier-val {
    color: #f8fafc;
    margin-bottom: 1;
}

.dossier-raw-box {
    height: 10;
    background: #07090e;
    border: round #1e293b;
    padding: 1;
    overflow-y: scroll;
}

/* ── Detection Status Panel ── */
.detection-item {
    padding: 0 1;
    margin-bottom: 1;
    border-bottom: dashed #1e293b;
}

/* ── Bottom Footer Bar ── */
Footer {
    background: #0b0f19;
    color: #94a3b8;
    border-top: solid #1e293b;
    height: 1;
}
